// BBT OS: let local desktop users talk to pcscd without a polkit prompt.
// pcsc-lite ships access_pcsc/access_card as allow_active=yes, but on this
// image pcscd answers the check with "not authorized", which breaks
// pcsc_scan, opensc-tool and the VPCD remote card reader. subject.local is
// false for SSH sessions, so remote logins stay denied.
polkit.addRule(function(action, subject) {
    if (action.id.indexOf("org.debian.pcsc-lite.") === 0 && subject.local) {
        return polkit.Result.YES;
    }
});
