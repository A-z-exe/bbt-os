/* BBT OS boot splash (Plymouth script theme) */

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

Window.SetBackgroundTopColor(0.012, 0.020, 0.039);
Window.SetBackgroundBottomColor(0.020, 0.075, 0.055);

background = Image("background.png");
if (background.GetWidth() != screen_w || background.GetHeight() != screen_h)
  background = background.Scale(screen_w, screen_h);
background_sprite = Sprite(background);
background_sprite.SetPosition(0, 0, -100);

logo = Image("logo.png");
if (screen_h < 700)
  logo = logo.Scale(logo.GetWidth() * 0.7, logo.GetHeight() * 0.7);
else if (screen_h < 900)
  logo = logo.Scale(logo.GetWidth() * 0.85, logo.GetHeight() * 0.85);

logo_x = (screen_w - logo.GetWidth()) / 2;
logo_y = (screen_h - logo.GetHeight()) / 2 - screen_h * 0.05;
logo_sprite = Sprite(logo);
logo_sprite.SetPosition(logo_x, logo_y, 10);

bar_width = Math.Clamp(screen_w * 0.22, 240, 420);
bar_height = 4;
bar_x = (screen_w - bar_width) / 2;
bar_y = logo_y + logo.GetHeight() + screen_h * 0.055;

bar_bg_image = Image("bar-bg.png").Scale(bar_width, bar_height);
bar_bg_sprite = Sprite(bar_bg_image);
bar_bg_sprite.SetPosition(bar_x, bar_y, 5);
bar_bg_sprite.SetOpacity(0.9);

bar_fg_image = Image("bar-fg.png").Scale(bar_width, bar_height);
bar_fg_sprite = Sprite(bar_fg_image);
bar_fg_sprite.SetPosition(bar_x, bar_y, 6);
bar_fg_sprite.SetOpacity(0);

global.message_sprite = 0;
global.password_dots = [];

fun set_message(text) {
  if (global.message_sprite)
    global.message_sprite.SetOpacity(0);
  image = Image.Text(text, 0.85, 1, 0.95);
  global.message_sprite = Sprite(image);
  global.message_sprite.SetPosition((screen_w - image.GetWidth()) / 2,
                                    bar_y + 26, 20);
}

fun set_progress(progress) {
  if (progress == NULL) progress = 0;
  if (progress > 1) progress = 1;
  if (progress < 0.01) {
    bar_fg_sprite.SetOpacity(0);
    return;
  }
  bar_fg_sprite.SetImage(bar_fg_image.Scale(bar_width * progress, bar_height));
  bar_fg_sprite.SetOpacity(1);
}

fun boot_progress_callback(duration, progress) {
  set_progress(progress);
}
Plymouth.SetBootProgressFunction(boot_progress_callback);

fun password_callback(prompt, bullets) {
  set_message(prompt);
  dot = Image("dot.png");
  for (i = 0; i < 16; i++) {
    if (!global.password_dots[i]) {
      global.password_dots[i] = Sprite(dot);
      global.password_dots[i].SetPosition(bar_x + i * 14, bar_y + 56, 20);
    }
    if (i < bullets) global.password_dots[i].SetOpacity(1);
    else global.password_dots[i].SetOpacity(0);
  }
}
Plymouth.SetDisplayPasswordFunction(password_callback);

fun hide_overlays() {
  if (global.message_sprite)
    global.message_sprite.SetOpacity(0);
  for (i = 0; global.password_dots[i]; i++)
    global.password_dots[i].SetOpacity(0);
}

fun normal_callback() {
  hide_overlays();
}
Plymouth.SetDisplayNormalFunction(normal_callback);

fun quit_callback() {
  hide_overlays();
  background_sprite.SetOpacity(0);
  logo_sprite.SetOpacity(0);
  bar_bg_sprite.SetOpacity(0);
  bar_fg_sprite.SetOpacity(0);
}
Plymouth.SetQuitFunction(quit_callback);
